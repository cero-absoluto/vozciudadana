# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # Full service role key — never expose publicly

# ── Twilio Verify (SMS OTP) ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SID=

# ── Resend (institutional email OTP) ─────────────────────────────────────────
RESEND_API_KEY=

# ── Push notifications (VAPID) ────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# ── Security — REQUIRED in production (server will refuse to start without these) ──
NULLIFIER_SECRET=                 # 64 hex chars — used for nullifier HMAC
PHONE_HASH_SECRET=                # 64 hex chars — used for phone and IP HMAC

ADMIN_SECRET=                     # Token for admin endpoints

# ── Costs and fees (defaults shown — override to adjust) ─────────────────────
SMS_COST_EUR=0.05
EMAIL_COST_EUR=0.01
PLATFORM_FEE_PERCENT=10           # % of each donation that goes to platform fund
MAX_DONATION_EUR=100              # Per-donation limit — reflects independence policy

# ── reCAPTCHA v3 ─────────────────────────────────────────────────────────────
RECAPTCHA_SECRET=

# ── Frontend URL (used for invite links in groups) ───────────────────────────
# Defaults to https://voiceprotest.org if not set
FRONTEND_URL=https://voiceprotest.org

# ── Notes ─────────────────────────────────────────────────────────────────────
# RAILWAY_PUBLIC_DOMAIN — injected automatically by Railway in production.
#   No need to set manually.
# CORS — currently configured in server.js directly (allows all origins for
#   public API endpoints used by the embeddable widget).
#   CORS_ORIGIN is not used by the current codebase.
