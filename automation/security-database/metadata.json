  "constraints": [
    {
      "name": "adhesions_device_id_fkey",
      "table": "adhesions",
      "validated": true,
      "definition": "FOREIGN KEY (device_id) REFERENCES devices(id)"
    },
    {
      "name": "adhesions_live_identity_required",
      "table": "adhesions",
      "validated": false,
      "definition": "CHECK (((anonymized_at IS NOT NULL) OR ((nullifier IS NOT NULL) AND (nullifier ~ '[^[:space:]]'::text) AND (identity_subject_hash IS NOT NULL) AND (identity_subject_hash ~ '[^[:space:]]'::text) AND (verification_method IS NOT NULL) AND ((verification_method <> 'phone_otp'::text) OR ((device_id IS NOT NULL) AND (device_id ~ '[^[:space:]]'::text)))))) NOT VALID"
    },
    {
      "name": "adhesions_nullifier_key",
      "table": "adhesions",
      "validated": true,
      "definition": "UNIQUE (nullifier)"
    },
    {
      "name": "adhesions_pais_code_check",
      "table": "adhesions",
      "validated": true,
      "definition": "CHECK (((pais_code IS NULL) OR (pais_code ~ '^[A-Z]{2}$'::text)))"
    },
    {
      "name": "adhesions_pkey",
      "table": "adhesions",
      "validated": true,
      "definition": "PRIMARY KEY (id)"
    },
    {
      "name": "adhesions_protest_id_device_id_key",
      "table": "adhesions",
      "validated": true,
      "definition": "UNIQUE (protest_id, device_id)"
    },
    {
      "name": "adhesions_protest_id_fkey",
      "table": "adhesions",
      "validated": true,
      "definition": "FOREIGN KEY (protest_id) REFERENCES protests(id) ON DELETE CASCADE"
    },
    {
      "name": "adhesions_verification_method_check",
      "table": "adhesions",
      "validated": true,
      "definition": "CHECK (((verification_method IS NULL) OR (verification_method = ANY (ARRAY['phone_otp'::text, 'institutional_email_otp'::text, 'qr'::text, 'eid'::text]))))"
    },
    {
      "name": "gps_update_tokens_adhesion_id_fkey",
      "table": "gps_update_tokens",
      "validated": true,
      "definition": "FOREIGN KEY (adhesion_id) REFERENCES adhesions(id) ON DELETE CASCADE"
    },
    {
      "name": "gps_update_tokens_pkey",
      "table": "gps_update_tokens",
      "validated": true,
      "definition": "PRIMARY KEY (token)"
    },
    {
      "name": "gps_update_tokens_protest_id_fkey",
      "table": "gps_update_tokens",
      "validated": true,
      "definition": "FOREIGN KEY (protest_id) REFERENCES protests(id) ON DELETE CASCADE"
    },
    {
      "name": "gps_update_tokens_used_requires_expires_after_creation",
      "table": "gps_update_tokens",
      "validated": true,
      "definition": "CHECK ((expires_at >= created_at))"
    }
  ],
