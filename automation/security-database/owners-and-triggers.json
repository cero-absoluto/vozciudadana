    },
    {
      "name": "a_erase_anonymized_identity",
      "table": "adhesions",
      "function": "erase_anonymized_identity()",
      "definition": "CREATE TRIGGER a_erase_anonymized_identity BEFORE INSERT OR UPDATE ON public.adhesions FOR EACH ROW EXECUTE FUNCTION erase_anonymized_identity()"
    },
    {
      "name": "census_admission_guard",
